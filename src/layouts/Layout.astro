---
import Nav from "../components/Nav.astro";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Manav Bokinala</title>
	</head>
	<body>
		<Nav />
		<div id="container">
			<slot />
		</div>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		padding: 20px;
		width: 100%;
		height: 100%;
		background-color: #e7e2df;
	}

	#container {
		max-width: 600px;
	}
</style>

<style is:global>
	@font-face {
		font-family: "Plantin";
		src: url("/fonts/Plantin.woff2") format("woff2");
	}

	body {
		font-family: "Plantin", "Georgia", serif;
		font-optical-sizing: auto;
		-webkit-font-smoothing: antialiased;

		font-size: 18px;
		line-height: 1.5;
	}

	h1 {
		font-size: 30px;
		font-weight: normal;
	}
</style>
